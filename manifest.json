{
  "manifest_version": 3,
  "name": "Cadence — Habit & Performance Tracker",
  "version": "2.4.0",
  "description": "A premium habit and focus workspace with rich insights, 4K new-tab personalization, soundscapes, focus sprints, streaks, and one-click weekly reports.",
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage", "unlimitedStorage", "alarms", "notifications", "topSites", "bookmarks", "identity", "tabs"],
  "host_permissions": [
    "https://suggestqueries.google.com/*",
    "https://images.unsplash.com/*",
    "http://localhost:3000/*",
    "http://127.0.0.1:3000/*",
    "https://*.supabase.co/*",
    "https://api.razorpay.com/*",
    "https://api.stripe.com/*"
  ],
  "omnibox": { "keyword": "cd" },
  "background": {
    "service_worker": "background.js"
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "Wallpaper/*",
        "assets/*",
        "icons/*",
        "common.js",
        "newtab.html",
        "newtab.css",
        "newtab.js",
        "cadence-agent.js",
        "cadence-agent.css",
        "blocked.html",
        "blocked.css",
        "lib/saas-client.js",
        "lib/saas-ui.js",
        "lib/saas-gate.js",
        "admin.html",
        "admin.js"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
