# ==============================================================================
# Cadence SaaS Configuration Template (.env.example)
# Copy this file to .env and populate with your credentials.
# NEVER commit your actual .env file with secrets into version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase Backend & Database Configuration
# ------------------------------------------------------------------------------
# Found in: Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
# Public anon key (safe for client-side / extension bundle)
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Service Role key (STRICTLY for backend server / Edge functions. NEVER put in extension!)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ------------------------------------------------------------------------------
# 2. Server Configuration
# ------------------------------------------------------------------------------
PORT=3000
NODE_ENV=development
APP_BASE_URL=http://localhost:3000
# Extension ID from chrome://extensions/ (e.g., chrome-extension://<id>)
ALLOWED_ORIGINS=chrome-extension://*,http://localhost:3000,http://localhost:5173

# Admin Dashboard Secret Access Key (protects /api/admin endpoints)
ADMIN_SECRET_KEY=cadence_admin_secure_secret_replace_in_prod

# ------------------------------------------------------------------------------
# 3. Razorpay Subscription Configuration (Preferred India Provider)
# ------------------------------------------------------------------------------
# Found in: Razorpay Dashboard -> Settings -> API Keys
RAZORPAY_KEY_ID=rzp_test_YourKeyId
RAZORPAY_KEY_SECRET=YourRazorpayKeySecret
# Webhook secret configured under Razorpay Dashboard -> Webhooks
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Razorpay Plan IDs created for recurring billing
# Monthly: ₹69 INR/month
RAZORPAY_PLAN_MONTHLY_ID=plan_monthly_69inr
# Yearly: ₹799 INR/year
RAZORPAY_PLAN_YEARLY_ID=plan_yearly_799inr

# ------------------------------------------------------------------------------
# 4. Stripe Subscription Configuration (Alternative Provider)
# ------------------------------------------------------------------------------
# Found in: Stripe Dashboard -> Developers -> API keys
STRIPE_SECRET_KEY=sk_test_51...
STRIPE_PUBLISHABLE_KEY=pk_test_51...
# Webhook signing secret from Stripe CLI or Dashboard -> Webhooks
STRIPE_WEBHOOK_SECRET=whsec_...
# Stripe Price IDs (recurring INR)
STRIPE_PRICE_MONTHLY_ID=price_monthly_69inr
STRIPE_PRICE_YEARLY_ID=price_yearly_799inr
# Customer portal URL
STRIPE_CUSTOMER_PORTAL_URL=https://billing.stripe.com/p/login/test_...
